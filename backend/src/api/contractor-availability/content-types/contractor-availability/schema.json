{
    "kind": "collectionType",
    "collectionName": "contractor_availabilities",
    "info": {
        "singularName": "contractor-availability",
        "pluralName": "contractor-availabilities",
        "displayName": "Contractor Availability",
        "description": "Daily availability records for contractors"
    },
    "options": {
        "draftAndPublish": false
    },
    "pluginOptions": {},
    "attributes": {
        "contractor": {
            "type": "relation",
            "relation": "manyToOne",
            "target": "api::contractor.contractor"
        },
        "date": {
            "type": "date",
            "required": true
        },
        "timeWindows": {
            "type": "json",
            "required": true
        },
        "blockedReason": {
            "type": "string"
        }
    }
}